<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaperSharp</RootNamespace>
    <AssemblyName>PaperSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- NuGet 包元数据；正式版本号由 CI 用 git tag 通过 -p:Version 覆盖 -->
    <Version>0.1.0</Version>
    <PackageId>PaperSharp</PackageId>
    <Authors>SpringHgui</Authors>
    <Description>要出分页文档，不必再为它养一个浏览器：一行 Renderer.RenderPdf(html, css) 就在 .NET 进程内产出矢量 PDF —— 文字可选中可搜索，@page 页边距、页眉页脚页码、表格跨页续 + 每页重放表头全部自动到位。单页中位约 30ms、单线程吞吐约 40 页/秒，类库线程安全可并发；零子进程、零调试端口、零 V8 内存包袱，容器与 CI 里开箱即用。内建中文原生排版（CJK 逐字折行、GB2312 字体子集 + 用字级嵌入，纯文字单页 PDF 约 90KB、中文数字页码），同一输入恒定产物，适合发票、合同、财务报表；同一管线还能出 PNG / JPEG / WebP / ICO / SVG。</Description>
    <PackageTags>pdf;html;css;render;document;skia;printing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SpringHgui/papersharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.3.1" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.0-beta.176" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="2.0.0" />
  </ItemGroup>

</Project>
