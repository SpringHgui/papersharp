<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaperSharp</RootNamespace>
    <AssemblyName>PaperSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- NuGet 包元数据；正式版本号由 CI 用 git tag 通过 -p:Version 覆盖 -->
    <Version>1.0.0</Version>
    <PackageId>PaperSharp</PackageId>
    <Authors>SpringHgui</Authors>
    <Description>要出分页文档，不必再为它养一个浏览器：一行 Renderer.RenderPdf(html, css) 就在 .NET 进程内产出矢量 PDF —— 文字可选中可搜索，@page 页边距、页眉页脚页码、表格跨页续 + 每页重放表头全部自动到位。单页中位约 30ms、单线程吞吐约 40 页/秒，类库线程安全可并发；零子进程、零调试端口、零 V8 内存包袱，容器与 CI 里开箱即用。内建中文原生排版（CJK 逐字折行、用字级字体子集嵌入，纯文字单页 PDF 约 50–120KB、中文数字页码），同一输入恒定产物，适合发票、合同、财务报表；同一管线还能出 PNG / JPEG / WebP / ICO / SVG。</Description>
    <PackageTags>pdf;html;css;render;document;skia;printing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SpringHgui/papersharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 打包子集字体随 dll 走（EmbeddedResource）：运行时不再依赖「入口程序集旁边有没有
       assets/fonts」。那是 PERF_REPORT §12.6 那条宿主依赖 bug 的根因——字体没进包，消费方
       静默退回系统字体，同一份 HTML 体积差 2.9~12.7 倍，而「PDF 体积 + 跨平台一致」正是
       这批子集存在的理由。LogicalName 写死：默认名随 RootNamespace/路径变，别哪天找不到。
       只嵌 Noto（OFL 可再分发）。雅黑/宋体的子集是微软/中易字体的派生二进制，不随 MIT 包
       分发；宿主需要它就 FontManager.BundledFontDirectory 指给自己的目录。 -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\NotoSansSCSub-Regular.ttf" LogicalName="PaperSharp.Fonts.NotoSansSCSub-Regular.ttf" />
    <EmbeddedResource Include="Fonts\NotoSansSCSub-Bold.ttf" LogicalName="PaperSharp.Fonts.NotoSansSCSub-Bold.ttf" />
  </ItemGroup>

  <!-- OFL 要求字体许可证随字体一并分发：嵌进 dll 不够，包内也要有一份。 -->
  <ItemGroup>
    <None Include="Fonts\OFL.txt" Pack="true" PackagePath="fonts\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="AngleSharp.Css" Version="1.1.4" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="2.0.0" />
  </ItemGroup>

</Project>
