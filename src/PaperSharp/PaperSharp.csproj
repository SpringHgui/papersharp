<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaperSharp</RootNamespace>
    <AssemblyName>PaperSharp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- NuGet 包元数据；正式版本号由 CI 用 git tag 通过 -p:Version 覆盖 -->
    <Version>0.1.0</Version>
    <PackageId>PaperSharp</PackageId>
    <Authors>SpringHgui</Authors>
    <Description>面向 .NET 的高性能文档渲染引擎：纯托管管线把 HTML/CSS 编译为矢量 PDF 与高清图片（PNG/JPEG/WebP/ICO/SVG），无需浏览器、无需 headless Chrome。</Description>
    <PackageTags>pdf;html;css;render;document;skia;printing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SpringHgui/papersharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.3.1" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.0-beta.176" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="2.0.0" />
  </ItemGroup>

</Project>
