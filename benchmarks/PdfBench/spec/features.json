{
  "doc": "challenge.html",
  "pageSize": "A4",
  "pages": 3,
  "note": "selector 相对 #pN；probe 坐标由 dump-dom getBoundingClientRect 提取",
  "features": [
    { "id": "headings",            "group": "text",   "page": 1, "selector": "#p1 h1" },
    { "id": "weights",             "group": "text",   "page": 1, "selector": "[data-f=weights]" },
    { "id": "inline-code-chip",    "group": "text",   "page": 1, "selector": "[data-f=codechip] span" },
    { "id": "cjk-latin-mixed",     "group": "text",   "page": 1, "selector": "[data-f=cjk]" },
    { "id": "line-height",         "group": "text",   "page": 1, "selector": "[data-f=lineheight]" },
    { "id": "letter-spacing",      "group": "text",   "page": 1, "selector": "[data-f=letterspacing]" },
    { "id": "text-indent",         "group": "text",   "page": 1, "selector": "[data-f=textindent]" },
    { "id": "text-shadow",         "group": "effect", "page": 1, "selector": "[data-f=textshadow]" },
    { "id": "text-color",          "group": "text",   "page": 1, "selector": "[data-f=coloredtext]" },
    { "id": "text-align-justify",  "group": "text",   "page": 1, "selector": "[data-f=align]" },
    { "id": "list-ul-marker-color","group": "text",   "page": 1, "selector": "[data-f=ul]" },
    { "id": "list-ol-decimal-alpha-roman", "group": "text", "page": 1, "selector": "[data-f=ol]" },
    { "id": "list-style-circle-none", "group": "text","page": 1, "selector": "[data-f=liststyle]" },
    { "id": "nested-list",         "group": "text",   "page": 1, "selector": "[data-f=ul] ul" },

    { "id": "border-solid",        "group": "border", "page": 2, "selector": "#bstyles .cell:nth-child(1)" },
    { "id": "border-dashed",       "group": "border", "page": 2, "selector": "#p2 .row:nth-of-type(3) .cell:nth-child(1)" },
    { "id": "border-dotted",       "group": "border", "page": 2, "selector": "#p2 .row:nth-of-type(4) .cell:nth-child(1)" },
    { "id": "border-double",       "group": "border", "page": 2, "selector": "#p2 .row:nth-of-type(5) .cell:nth-child(1)" },
    { "id": "border-groove-ridge", "group": "border", "page": 2, "selector": "#p2 .row:nth-of-type(5) .cell:nth-child(2)" },
    { "id": "border-width-2-4-8",  "group": "border", "page": 2, "selector": "#bstyles" },
    { "id": "border-per-side-style","group": "border","page": 2, "selector": "[data-f=per-side] .cell:nth-child(1)" },
    { "id": "border-per-side-color","group": "border","page": 2, "selector": "[data-f=per-side] .cell:nth-child(2)" },
    { "id": "border-currentcolor", "group": "border", "page": 2, "selector": "[data-f=per-side] .cell:nth-child(3)" },
    { "id": "border-single-side",  "group": "border", "page": 2, "selector": "[data-f=single-side]" },
    { "id": "radius-uniform",      "group": "radius", "page": 2, "selector": "[data-f=radius] .cell:nth-child(3)" },
    { "id": "radius-per-corner",   "group": "radius", "page": 2, "selector": "[data-f=radius] .cell:nth-child(5)" },
    { "id": "radius-circle-ellipse","group": "radius","page": 2, "selector": "[data-f=circle-pill]" },
    { "id": "radius-pill",         "group": "radius", "page": 2, "selector": "[data-f=circle-pill] div:nth-child(5)" },
    { "id": "radius-plus-dashed",  "group": "radius", "page": 2, "selector": "[data-f=circle-pill] div:nth-child(7)" },
    { "id": "border-radius-bg-clip","group": "radius","page": 2, "selector": "[data-f=compound] .row>div:nth-child(2)" },
    { "id": "triangle-via-border", "group": "border", "page": 2, "selector": "[data-f=border-triangle]" },

    { "id": "box-shadow-soft",     "group": "effect", "page": 3, "selector": "[data-f=shadow] div:nth-child(1)" },
    { "id": "box-shadow-hard",     "group": "effect", "page": 3, "selector": "[data-f=shadow] div:nth-child(2)" },
    { "id": "box-shadow-inset",    "group": "effect", "page": 3, "selector": "[data-f=shadow] div:nth-child(3)" },
    { "id": "box-shadow-multi",    "group": "effect", "page": 3, "selector": "[data-f=shadow] div:nth-child(4)" },
    { "id": "linear-gradient-multi-stop","group": "gradient","page": 3, "selector": "[data-f=gradient] div:nth-child(1)" },
    { "id": "radial-gradient",     "group": "gradient","page": 3, "selector": "[data-f=gradient] div:nth-child(3)" },
    { "id": "gradient-with-alpha", "group": "gradient","page": 3, "selector": "[data-f=gradient] div:nth-child(4)" },
    { "id": "rgba-overlap-blend",  "group": "effect", "page": 3, "selector": "[data-f=transparency] > div:nth-child(1)" },
    { "id": "opacity",             "group": "effect", "page": 3, "selector": "[data-f=transparency] .cell:nth-of-type(2)" },
    { "id": "inline-alpha-highlight","group": "effect","page": 3, "selector": "[data-f=transparency] span" },
    { "id": "image-jpeg",          "group": "image",  "page": 3, "selector": "[data-f=images] img:nth-of-type(1)" },
    { "id": "image-png-alpha",     "group": "image",  "page": 3, "selector": "[data-f=images] div>div:nth-child(2) img" },
    { "id": "image-rounded-border","group": "image",  "page": 3, "selector": "[data-f=images] img[height='110']" },
    { "id": "flex-space-between",  "group": "layout", "page": 3, "selector": "[data-f=flex] div>div:nth-child(1)" },
    { "id": "flex-margin-auto",    "group": "layout", "page": 3, "selector": "[data-f=flex] .cell[style*=margin-left]" },
    { "id": "flex-wrap-gap",       "group": "layout", "page": 3, "selector": "[data-f=flex] [style*=wrap]" },
    { "id": "flex-nested-ratios",  "group": "layout", "page": 3, "selector": "[data-f=flex] [style*='flex:1;background'] " },
    { "id": "flex-cross-axis-center","group": "layout","page": 3, "selector": "[data-f=flex] div[style*='justify-content:center']" },
    { "id": "table-thead-tfoot",   "group": "table",  "page": 3, "selector": "[data-f=table]" },
    { "id": "table-striped",       "group": "table",  "page": 3, "selector": "[data-f=table] tr[style*=background]" },
    { "id": "table-cell-borders",  "group": "table",  "page": 3, "selector": "[data-f=table] td" },
    { "id": "table-colspan-footer","group": "table",  "page": 3, "selector": "[data-f=table] tfoot td[colspan]" },
    { "id": "word-break-all",      "group": "text",   "page": 3, "selector": "[data-f=wordbreak]" },
    { "id": "page-header-footer",  "group": "doc",    "page": "all", "selector": ".hdr, .ftr" },
    { "id": "page-number-badge",   "group": "doc",    "page": "all", "selector": ".pageno" }
  ]
}
